#!/usr/bin/env bash
# Runs the criterion benchmarks and writes the median times to BENCHMARKS.md.
#
#   scripts/bench                  quick run (short warm-up, 10 samples per benchmark)
#   scripts/bench --full           criterion's default settings (slow)
#   scripts/bench scc              only benchmarks that match the filter (here: group names scc/...)
#   scripts/bench -- --save-baseline before    arguments after `--` go to criterion unchanged
#
# BENCHMARKS.md is only rewritten when all benchmarks ran (no filter); otherwise the table
# is printed to stdout. Compare against a saved baseline with
# `cargo bench -- --baseline before`.
set -euo pipefail
cd "$(dirname "$0")/.."

settings=(--warm-up-time 0.5 --measurement-time 2 --sample-size 10)
filter=()
extra=()
while [ $# -gt 0 ]; do
    case "$1" in
        --full) settings=() ;;
        --) shift; extra=("$@"); break ;;
        *) filter+=("$1") ;;
    esac
    shift
done

start=$(date +%s)
cargo bench --bench scc --bench operations -- "${filter[@]}" "${settings[@]}" "${extra[@]}"

python3 - "$start" "${#filter[@]}" "${settings[*]:-full}" <<'PY'
import json, os, subprocess, sys, time
from collections import defaultdict
from pathlib import Path

start, filtered, settings = float(sys.argv[1]), int(sys.argv[2]) > 0, sys.argv[3]

def fmt(ns):
    for unit, scale in (("s", 1e9), ("ms", 1e6), ("µs", 1e3)):
        if ns >= scale:
            return f"{ns / scale:.3g} {unit}"
    return f"{ns:.3g} ns"

groups = defaultdict(lambda: defaultdict(dict))
params = defaultdict(set)
for bench in Path("target/criterion").rglob("new/benchmark.json"):
    estimates = bench.with_name("estimates.json")
    if not estimates.exists() or estimates.stat().st_mtime < start:
        continue
    info = json.loads(bench.read_text())
    median = json.loads(estimates.read_text())["median"]["point_estimate"]
    group, function = info["group_id"], info["function_id"] or "-"
    param = info["value_str"] or "-"
    groups[group][function][param] = median
    params[group].add(param)

def key(p):
    return (0, int(p)) if p.isdigit() else (1, p)

def sh(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout.strip()
    except Exception:
        return "unknown"

cpu = "unknown"
try:
    cpu = next(l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name"))
except Exception:
    pass

out = ["# Benchmarks", "",
       "Median times, generated by `scripts/bench`. They only make sense compared to numbers from the same machine; "
       "for a before/after comparison use criterion baselines (`cargo bench -- --save-baseline before`, then `--baseline before`).", "",
       f"- date: {time.strftime('%Y-%m-%d')}",
       f"- commit: {sh('git', 'rev-parse', '--short', 'HEAD')}{' (dirty)' if sh('git', 'status', '--porcelain') else ''}",
       f"- cpu: {cpu}",
       f"- rustc: {sh('rustc', '--version')}",
       f"- settings: {'criterion defaults' if settings == 'full' else settings}", ""]
for group in sorted(groups):
    cols = sorted(params[group], key=key)
    out += [f"## {group}", "", "| | " + " | ".join(cols) + " |", "|---|" + "---:|" * len(cols)]
    for function in sorted(groups[group]):
        row = groups[group][function]
        out.append(f"| {function} | " + " | ".join(fmt(row[c]) if c in row else "" for c in cols) + " |")
    out.append("")
text = "\n".join(out)
if filtered:
    print(text)
else:
    Path("BENCHMARKS.md").write_text(text)
    print("wrote BENCHMARKS.md")
PY
