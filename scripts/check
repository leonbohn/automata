#!/usr/bin/env bash
# Runs the same checks as the CI workflow (.github/workflows/ci.yml).
set -e

cargo fmt --check
echo "cargo fmt --check passed"
cargo clippy --all-targets -- -D warnings
cargo clippy --all-targets --no-default-features -- -D warnings
cargo clippy --all-targets --all-features -- -D warnings
echo "cargo clippy passed (default, no default, all features)"
RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features
echo "cargo doc passed"
if command -v cargo-hack >/dev/null 2>&1; then
    cargo hack check --each-feature --no-dev-deps
    echo "cargo hack check --each-feature passed"
else
    echo "cargo-hack not installed, skipping the per-feature check"
fi
cargo test
cargo test --no-default-features
cargo test --all-features
echo "cargo test passed (default, no default, all features)"
